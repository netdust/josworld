includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # Pre-existing findings in the vendored framework + theme, frozen at gate
    # introduction. New code must be clean; do not add to this file.
    # Coupling: the baseline references the theme only. ntdst-core became a
    # composer package (2026-08-12) and is excluded wholesale below — its
    # former baseline entries were removed; regenerate with --generate-baseline
    # after changing the theme.
    - phpstan-baseline.neon

parameters:
    level: 6
    # Project-local cache — NEVER the shared system tmp. PHPStan's default
    # tmpDir (sys_get_temp_dir()/phpstan) is shared by every project on the
    # host: stale reflection entries pointing at another project's (since
    # deleted/moved) phpstan.phar poison a fresh site's FIRST `composer gate`
    # with "phar://…/phpstan.phar/….stub is not a file" internal errors
    # (hit on the T04 acceptance run via a stale gate-pilot cache).
    # Relative path → resolved beside this file, i.e. the project root.
    # The dir ships with the gate payload and self-ignores (.gitignore inside).
    # Coupling: run ALL phpstan invocations from ONE context (the host — the
    # gate is host-orchestrated); a container run would seed this shared,
    # mounted cache with container paths and recreate the same poisoning.
    tmpDir: .phpstan-cache
    scanFiles:
        # WP test-scaffold symbols (WP_UnitTestCase & friends) for the
        # integration tier under tests/Integration — discovery only, the
        # scaffold itself is never analysed. Deliberately NOT the whole
        # includes/ dir: its object-cache.php redeclares wp_cache_get with
        # a narrower signature than the WordPress stubs and would shadow it.
        - vendor/wp-phpunit/wp-phpunit/includes/phpunit-adapter-testcase.php
        - vendor/wp-phpunit/wp-phpunit/includes/abstract-testcase.php
        - vendor/wp-phpunit/wp-phpunit/includes/testcase.php
        # T05's cached-meta seam
        # (app/content/themes/josworld/services/yootheme/ntdst-cached-meta-
        # accessor.php) declares `ntdst_get_post_meta_from_cache()` guarded by
        # `function_exists()` and lazily `require_once`d from inside
        # FieldResolver::resolve() — required so Brain Monkey/Patchwork can
        # intercept it at the unit tier (see that file's docblock). PHPStan
        # does not reflect conditionally-declared functions and does not
        # follow a require inside a method body, so this signature-only stub
        # makes the symbol analysable without changing the guarded, lazily-
        # loaded runtime shape.
        - tests/phpstan-stubs/ntdst_get_post_meta_from_cache.stub.php
    paths:
        - app/content/mu-plugins
        - app/content/themes
        - tests
    excludePaths:
        # Composer-installed stock theme — not our code (constant name, portability-safe)
        - app/content/themes/twentytwentyfive (?)
        # YOOtheme Pro — licensed vendor parent theme, updated in-place via the
        # YOOtheme license (never edited here, never committed: .gitignore
        # ignores app/content/themes/* and re-includes only josworld/).
        # Same posture as the stock theme above: not our code, not analysed.
        - app/content/themes/yootheme (?)
        # Theme build artifacts / JS dependencies — never analysed.
        # Trailing /* is required: wildcard excludePaths are fnmatch'd against
        # FILE paths, so a bare .../node_modules pattern never matches the files
        # beneath it (surfaced by flatted/php/flatted.php inside npm deps).
        - app/content/themes/*/node_modules/* (?)
        - app/content/themes/*/dist/* (?)
        # Signature-only PHPStan stub, loaded above via scanFiles for
        # DISCOVERY only — its intentionally-empty body (no return
        # statement) would otherwise fail its own analysis as a real file
        # under the `tests` path.
        - tests/phpstan-stubs/* (?)
        # netdust/ntdst-core is a composer package with its own repo, gate,
        # and reviewers (github.com/netdust/ntdst-core) — only OUR code is
        # analysed here (ruling 2026-08-12). Same posture as vendor/ and the
        # YOOtheme parent above. Its 209 pre-extraction baseline entries were
        # removed together with this exclude.
        - app/content/mu-plugins/ntdst-core/* (?)
