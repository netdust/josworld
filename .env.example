# ── Database ────────────────────────────────────────────────────────────────
# DDEV defaults: name/user/pass/host are all "db".
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_HOST=db
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci
# DB_TABLE_PREFIX=ntdst_

# ── WordPress URLs ──────────────────────────────────────────────────────────
# Core lives at app/wp with app/ as the docroot, so the site URL is always
# ${WP_HOME}/wp. Keep WP_SITEURL double-quoted: phpdotenv only interpolates
# ${WP_HOME} inside double quotes.
WP_HOME=https://example.ddev.site
WP_SITEURL="${WP_HOME}/wp"

# ── Environment ─────────────────────────────────────────────────────────────
# development | staging | production
# WP_ENVIRONMENT_TYPE drives the WP_DEBUG switch in app/wp-config.php.
# WP_ENV is unread by this template — kept for Bedrock-convention tooling;
# the debug switch reads WP_ENVIRONMENT_TYPE.
WP_ENV=development
WP_ENVIRONMENT_TYPE=development

# ── Security salts ──────────────────────────────────────────────────────────
# Append your own (never commit real salts):
# curl -s https://api.wordpress.org/secret-key/1.1/salt | sed "s/^define('\(.*\)',\ *'\(.*\)');$/\1='\2'/g"

# ── Optional: Redis object cache ────────────────────────────────────────────
# WP_CACHE_KEY_SALT=example-cache-salt
# WP_REDIS_HOST=127.0.0.1
# WP_REDIS_PORT=6379
# WP_REDIS_DATABASE=0
