# Ignore everything in the root
/*

# Ignore framework directories everywhere
**/wp/
**/vendor/
**/node_modules/

# Ignore files starting with . or ~
.*
~*

# Ignore DS_Store files generated by Finder on MacOS
**/.DS_Store

# Ignore OS-generated files
ehthumbs.db
Thumbs.db
.rnd

# Ignore log files and databases
*.log
*.sql
*.sqlite

# Ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# -------------------------
# Whitelisted Files
# -------------------------

# Track these files, if they exist
!.htaccess
!.gitignore
!.env.example
!.editorconfig
!.phpcs.xml.dist
!README.md
!CHANGELOG.md
!composer.json
!composer.lock
!wp-cli.yml
!Makefile
!Makefile.netdust
!mk/
!.netdust-devops
!phpstan-baseline.neon

# Track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest

# -------------------------
# Gate layer (born-gated parity with bedrock site repos — review I4)
# -------------------------

# The wp-starter gate payload lands at the project root; pin it so scaffolded
# sites track their test/analysis stack the way bedrock sites do.
!tests/
!tests/**
!bin/
!bin/**
!phpstan.neon
!phpcs.xml
!pint.json
!phpunit.unit.xml
!phpunit.integration.xml
!playwright.config.ts
!tsconfig.json
!package.json
!package-lock.json
!README-testing.md

# DDEV config: track it like bedrock does — DDEV's own generated nested
# .ddev/.gitignore keeps the ephemeral pieces (builds, snapshots, certs) out.
!.ddev/
!.ddev/**

# phpstan cache dir: only its self-ignore keeper is trackable — contents stay
# ignored here AND via the payload's own .phpstan-cache/.gitignore
# ('*' + '!.gitignore'), so cache files never track even if one layer is absent.
!.phpstan-cache/
.phpstan-cache/*
!.phpstan-cache/.gitignore

# -------------------------
# Harness meta layer (born-gated parity with bedrock site repos)
# -------------------------

# The netdust-wp meta layer: operating manual, operational config, project
# memory, task list, and the deploy tooling. Bedrock site repos track all of
# these; the stackwp .gitignore whitelisted the GATE layer only, so site.yml
# and tasks/ were ignored here while CLAUDE.md and memory/ happened to be
# tracked — the same layer, half in and half out.
#
# scripts/ is not optional decoration: the shared Makefile resolves EVERY
# host, path, branch and payload entry through `scripts/site`. Untracked, a
# clone gets a Makefile that cannot read its own config — `make help` and
# every deploy target break on the first $(shell scripts/site …).
!CLAUDE.md
!site.yml
!scripts/
!scripts/**
!memory/
!memory/**
!tasks/
!tasks/**

# -------------------------
# App directory rules
# -------------------------

# Allow the app directory
!app/

# Allow app/content and its subdirectories
!app/content/
!app/content/**

# Runtime caches (Matomo's lives here) — never tracked
app/content/cache/

# Ignore uploads directory (user files)
app/content/uploads/

# Ignore WordPress language packs — downloaded per host from wordpress.org and
# regenerated on update. Not in deploy.payload, so no environment needs them
# from git; nl_BE alone is 6 MB of generated .mo/.po.
app/content/languages/

# Ignore debug logs
app/content/debug.log

# Ignore runtime logs — daily rotation churns these; they must never be tracked.
# Must stay AFTER the !app/content/** re-include above to win. Non-log files
# in logs/ (.htaccess, index.html, .gitkeep) remain trackable.
app/content/logs/*.log


# Ignore all plugins by default
app/content/plugins/*

# Allow specific custom plugins (add your custom plugins here)
# Example: !app/content/plugins/my-custom-plugin/

# Allow index.php protection files
!app/content/plugins/index.php

# Ignore all themes by default
app/content/themes/*

# Allow specific custom themes (add your custom theme here)
# Example: !app/content/themes/my-theme/

# Allow index.php protection files
!app/content/themes/index.php

# Allow all mu-plugins (typically custom code)
!app/content/mu-plugins/
!app/content/mu-plugins/**

# Allow app root files
!app/.htaccess
!app/index.php
!app/wp-config.php

# Re-ignore Zone.Identifier files (must stay last so it wins over whitelists)
**/*:Zone.Identifier
# Track this site's own theme (the deliverable) — scaffold-appended
!app/content/themes/josworld/
!app/content/themes/josworld/**
# Never the theme's deps/build residue (must FOLLOW the whitelist above)
app/content/themes/josworld/node_modules/
app/content/themes/josworld/dist/

# Track project memory (STATE.md/ARCHIVE.md/lessons.md) and docs — both are
# project deliverables per CLAUDE.md, not scratch. Pre-existing gap: this
# whitelist entry was missing even though `memory/.stop-hook-state.json`
# below already assumed memory/ was partly trackable (T12).
!memory/
!memory/**
!docs/
!docs/**

# Re-assert (must stay last so it wins over whitelists)
**/*:Zone.Identifier
memory/.stop-hook-state.json
.yoo-tools/

# netdust/ntdst-core is now a composer package (app/composer.json), installed
# via installer-paths into content/mu-plugins/ntdst-core/ — externally
# managed like vendor/, never hand-edited or committed here.
app/content/mu-plugins/ntdst-core/

# netdust/ntdst-baseline is now a composer package (app/composer.json),
# installed via installer-paths into content/mu-plugins/ntdst-baseline/ —
# externally managed like vendor/, never hand-edited or committed here.
app/content/mu-plugins/ntdst-baseline/

# Local reference material: design-asset exports and paid plugin zips never enter the repo.
docs/*.zip
docs/Assets-*/
