# Ignore everything in the root
/*

# Ignore framework directories everywhere
**/wp/
**/vendor/
**/node_modules/

# Ignore files starting with . or ~
.*
~*

# Ignore DS_Store files generated by Finder on MacOS
**/.DS_Store

# Ignore OS-generated files
ehthumbs.db
Thumbs.db
.rnd

# Ignore log files and databases
*.log
*.sql
*.sqlite

# Ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# -------------------------
# Whitelisted Files
# -------------------------

# Track these files, if they exist
!.htaccess
!.gitignore
!.env.example
!.editorconfig
!.phpcs.xml.dist
!README.md
!CHANGELOG.md
!composer.json
!composer.lock
!wp-cli.yml
!Makefile
!phpstan-baseline.neon

# Track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest

# -------------------------
# Gate layer (born-gated parity with bedrock site repos — review I4)
# -------------------------

# The wp-starter gate payload lands at the project root; pin it so scaffolded
# sites track their test/analysis stack the way bedrock sites do.
!tests/
!tests/**
!bin/
!bin/**
!phpstan.neon
!phpcs.xml
!phpunit.unit.xml
!phpunit.integration.xml
!playwright.config.ts
!tsconfig.json
!package.json
!package-lock.json
!README-testing.md

# DDEV config: track it like bedrock does — DDEV's own generated nested
# .ddev/.gitignore keeps the ephemeral pieces (builds, snapshots, certs) out.
!.ddev/
!.ddev/**

# phpstan cache dir: only its self-ignore keeper is trackable — contents stay
# ignored here AND via the payload's own .phpstan-cache/.gitignore
# ('*' + '!.gitignore'), so cache files never track even if one layer is absent.
!.phpstan-cache/
.phpstan-cache/*
!.phpstan-cache/.gitignore

# -------------------------
# App directory rules
# -------------------------

# Allow the app directory
!app/

# Allow app/content and its subdirectories
!app/content/
!app/content/**

# Ignore uploads directory (user files)
app/content/uploads/

# Ignore debug logs
app/content/debug.log

# Ignore runtime logs — daily rotation churns these; they must never be tracked.
# Must stay AFTER the !app/content/** re-include above to win. Non-log files
# in logs/ (.htaccess, index.html, .gitkeep) remain trackable.
app/content/logs/*.log


# Ignore all plugins by default
app/content/plugins/*

# Allow specific custom plugins (add your custom plugins here)
# Example: !app/content/plugins/my-custom-plugin/

# Allow index.php protection files
!app/content/plugins/index.php

# Ignore all themes by default
app/content/themes/*

# Allow specific custom themes (add your custom theme here)
# Example: !app/content/themes/my-theme/

# Allow index.php protection files
!app/content/themes/index.php

# Allow all mu-plugins (typically custom code)
!app/content/mu-plugins/
!app/content/mu-plugins/**

# Allow app root files
!app/.htaccess
!app/index.php
!app/wp-config.php

# Re-ignore Zone.Identifier files (must stay last so it wins over whitelists)
**/*:Zone.Identifier
# Track this site's own theme (the deliverable) — scaffold-appended
!app/content/themes/josworld/
!app/content/themes/josworld/**
# Never the theme's deps/build residue (must FOLLOW the whitelist above)
app/content/themes/josworld/node_modules/
app/content/themes/josworld/dist/
# Re-assert (must stay last so it wins over whitelists)
**/*:Zone.Identifier
memory/.stop-hook-state.json
