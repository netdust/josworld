{
  "name": "ntdst/stackedwp",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with Composer, Make and more candy",
  "homepage": "https://netdust.be/stackedwp/",
  "authors": [
    {
      "name": "Stefan Vandermeulen",
      "email": "stefan@netdust.be",
      "homepage": "https://github.com/netdust"
    }
  ],
  "keywords": [
    "stackedWP",
    "composer",
    "make",
    "wordpress",
    "wp",
    "config"
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "/home/ntdst/Sites/ntdst-core"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.2",
    "netdust/ntdst-core": "^2.2",
    "vlucas/phpdotenv": "^5.5"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "vendor-dir": "vendor/",
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  }
}
