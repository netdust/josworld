{
  "name": "ntdst/stackedwp",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with Composer, Make and more candy",
  "homepage": "https://netdust.be/stackedwp/",
  "authors": [
    {
      "name": "Stefan Vandermeulen",
      "email": "stefan@netdust.be",
      "homepage": "https://github.com/netdust"
    }
  ],
  "keywords": [
    "stackedWP",
    "composer",
    "make",
    "wordpress",
    "wp",
    "config"
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "laravel/pint": "^1.18",
    "brain/monkey": "^2.7",
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "wp-phpunit/wp-phpunit": "~6.8.0",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "process-timeout": 0,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "lint": "phpcs",
    "format": "pint --test",
    "format:fix": "pint",
    "test:unit": "vendor/bin/phpunit -c phpunit.unit.xml",
    "test:int": "vendor/bin/phpunit -c phpunit.integration.xml",
    "analyse": "phpstan analyse --no-progress",
    "audit:deps": [
      "@composer audit",
      "@audit:js"
    ],
    "audit:js": "sh bin/js-gate.sh audit:js 'audit --audit-level=high'",
    "lint:js": "sh bin/js-gate.sh lint:js 'run lint' 'run lint:css'",
    "test:js": [
      "@test:js:themes",
      "@test:js:muplugins"
    ],
    "test:js:themes": "sh bin/js-gate.sh test:js 'run test'",
    "test:js:muplugins": "npm run test:js:muplugins",
    "test:e2e": "sh bin/e2e.sh",
    "build:check": "sh bin/js-gate.sh build:check 'run build'",
    "gate": "sh bin/gate.sh"
  }
}
